# Backend
SMG_STORAGE_DIR=./storage
SMG_DATABASE_URL=sqlite:///./storage/smart_meal_guide.db
SMG_SESSION_TTL_DAYS=7
SMG_SESSION_COOKIE=smg_session
SMG_COOKIE_SECURE=false
SMG_COOKIE_SAMESITE=lax
SMG_MAX_UPLOAD_BYTES=8388608

# Replace with the exact deployed frontend origin before production.
SMG_FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# OBS is intentionally disabled until the university provides an approved integration method.
SMG_OBS_ENABLED=false
